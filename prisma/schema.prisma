generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================
// ENUMS
// =========================================

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
  SUPER_ADMIN
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleType {
  MOTORCYCLE
  PICKUP
  BOX_TRUCK
  LARGE_TRUCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DRIVER_ASSIGNED
  EN_ROUTE_TO_PICKUP
  ARRIVED_AT_PICKUP
  LOADING
  IN_TRANSIT
  ARRIVED_AT_DROPOFF
  UNLOADING
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  CASH
  VIRTUAL_ACCOUNT
  E_WALLET
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PromoType {
  PERCENTAGE
  FIXED_AMOUNT
}

// =========================================
// AUTH / USERS
// =========================================

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true) @map("is_active")
  isVerified    Boolean   @default(false) @map("is_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customerProfile CustomerProfile?
  partner         Partner?
  adminProfile    AdminProfile?
  refreshTokens   RefreshToken[]
  addresses       CustomerAddress[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("customer_profiles")
}

model CustomerAddress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String
  address   String
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  tier      String   @default("staff") // staff, manager, super_admin
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// =========================================
// PARTNERS / VEHICLES
// =========================================

model Partner {
  id               String        @id @default(uuid())
  userId           String        @unique @map("user_id")
  ktpNumber        String        @unique @map("ktp_number")
  ktpPhotoUrl      String        @map("ktp_photo_url")
  simNumber        String        @unique @map("sim_number")
  simPhotoUrl      String        @map("sim_photo_url")
  status           PartnerStatus @default(PENDING)
  isOnline         Boolean       @default(false) @map("is_online")
  currentLatitude  Decimal?      @db.Decimal(10, 7) @map("current_latitude")
  currentLongitude Decimal?      @db.Decimal(10, 7) @map("current_longitude")
  rating           Decimal       @default(0) @db.Decimal(3, 2)
  totalTrips       Int           @default(0) @map("total_trips")
  approvedBy       String?       @map("approved_by")
  approvedAt       DateTime?     @map("approved_at")
  rejectionReason  String?       @map("rejection_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]
  orders         Order[]
  ratingsGiven   Rating[]         @relation("PartnerRatings")
  payouts        Payout[]
  trackingPoints TrackingPoint[]

  @@map("partners")
}

model Vehicle {
  id           String      @id @default(uuid())
  partnerId    String      @map("partner_id")
  type         VehicleType
  plateNumber  String      @unique @map("plate_number")
  brand        String
  model        String
  photoUrl     String?     @map("photo_url")
  stnkPhotoUrl String      @map("stnk_photo_url")
  maxWeightKg  Decimal     @map("max_weight_kg") @db.Decimal(8, 2)
  maxVolumeM3  Decimal     @map("max_volume_m3") @db.Decimal(8, 2)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@map("vehicles")
}

// =========================================
// PRICING
// =========================================

model PricingZone {
  id           String   @id @default(uuid())
  name         String
  baseFare     Decimal  @map("base_fare") @db.Decimal(12, 2)
  perKmRate    Decimal  @map("per_km_rate") @db.Decimal(12, 2)
  vehicleType  VehicleType
  minDistance  Decimal  @default(0) @map("min_distance") @db.Decimal(8, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("pricing_zones")
}

model PromoCode {
  id            String    @id @default(uuid())
  code          String    @unique
  type          PromoType
  value         Decimal   @db.Decimal(12, 2)
  maxDiscount   Decimal?  @map("max_discount") @db.Decimal(12, 2)
  minOrderValue Decimal?  @map("min_order_value") @db.Decimal(12, 2)
  usageLimit    Int?      @map("usage_limit")
  usedCount     Int       @default(0) @map("used_count")
  validFrom     DateTime  @map("valid_from")
  validUntil    DateTime  @map("valid_until")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  orders Order[]

  @@map("promo_codes")
}

// =========================================
// ORDERS
// =========================================

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique @map("order_number")
  customerId        String      @map("customer_id")
  partnerId         String?     @map("partner_id")
  vehicleId         String?     @map("vehicle_id")
  promoCodeId       String?     @map("promo_code_id")

  pickupAddress     String      @map("pickup_address")
  pickupLatitude    Decimal     @db.Decimal(10, 7) @map("pickup_latitude")
  pickupLongitude   Decimal     @db.Decimal(10, 7) @map("pickup_longitude")
  dropoffAddress    String      @map("dropoff_address")
  dropoffLatitude   Decimal     @db.Decimal(10, 7) @map("dropoff_latitude")
  dropoffLongitude  Decimal     @db.Decimal(10, 7) @map("dropoff_longitude")
  distanceKm        Decimal     @map("distance_km") @db.Decimal(8, 2)

  vehicleType       VehicleType @map("vehicle_type")
  itemDescription   String?     @map("item_description")
  scheduledAt        DateTime?   @map("scheduled_at")

  estimatedPrice    Decimal     @map("estimated_price") @db.Decimal(12, 2)
  negotiatedPrice   Decimal?    @map("negotiated_price") @db.Decimal(12, 2)
  finalPrice        Decimal?    @map("final_price") @db.Decimal(12, 2)
  discountAmount    Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)

  status            OrderStatus @default(PENDING)
  cancelReason      String?     @map("cancel_reason")
  cancelledBy       String?     @map("cancelled_by")

  createdAt         DateTime    @default(now()) @map("created_at")
  confirmedAt       DateTime?   @map("confirmed_at")
  completedAt       DateTime?   @map("completed_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  customer      CustomerProfile @relation(fields: [customerId], references: [id])
  partner       Partner?        @relation(fields: [partnerId], references: [id])
  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id])
  promoCode     PromoCode?      @relation(fields: [promoCodeId], references: [id])

  statusHistory   OrderStatusHistory[]
  trackingPoints  TrackingPoint[]
  rating          Rating?
  payment         Payment?

  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// =========================================
// TRACKING
// =========================================

model TrackingPoint {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  partnerId String   @map("partner_id")
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  speedKmh  Decimal? @map("speed_kmh") @db.Decimal(6, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([orderId, recordedAt])
  @@map("tracking_points")
}

// =========================================
// RATINGS
// =========================================

model Rating {
  id         String   @id @default(uuid())
  orderId    String   @unique @map("order_id")
  partnerId  String   @map("partner_id")
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner Partner @relation("PartnerRatings", fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

// =========================================
// PAYMENTS
// =========================================

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique @map("order_id")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  commissionRate  Decimal       @default(0.15) @map("commission_rate") @db.Decimal(4, 3)
  commissionAmount Decimal      @default(0) @map("commission_amount") @db.Decimal(12, 2)
  partnerEarning  Decimal       @default(0) @map("partner_earning") @db.Decimal(12, 2)
  gatewayProvider String?       @map("gateway_provider") // midtrans, xendit
  gatewayRefId    String?       @map("gateway_ref_id")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Payout {
  id         String   @id @default(uuid())
  partnerId  String   @map("partner_id")
  amount     Decimal  @db.Decimal(12, 2)
  periodFrom DateTime @map("period_from")
  periodTo   DateTime @map("period_to")
  status     String   @default("pending") // pending, processed, failed
  processedAt DateTime? @map("processed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("payouts")
}

// =========================================
// ADMIN / SUPPORT
// =========================================

model Dispute {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  raisedBy    String   @map("raised_by") // user id
  reason      String
  status      String   @default("open") // open, resolved, rejected
  resolution  String?
  resolvedBy  String?  @map("resolved_by")
  createdAt   DateTime @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@map("disputes")
}
